import java.util.Scanner;
public class Task06 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();
        System.out.print("Enter index to delete: ");
        int index = sc.nextInt(); // Index to delete
        for (int i = index; i < arr.length - 1; i++) { // Shift left
            arr[i] = arr[i+1]; // Overwrite with next element
        }
        System.out.print("Updated array: ");
        for (int i = 0; i < arr.length - 1; i++) System.out.print(arr[i] + " "); // Display 9 elements
        sc.close();
    }
}
// Time Complexity: O(n)