import java.util.Scanner;
public class Task04 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();
        System.out.print("Enter number to search: ");
        int key = sc.nextInt(); // Number to find
        boolean found = false; // Flag
        System.out.print("Found at indices: ");
        for (int i = 0; i < arr.length; i++) { // Linear search
            if (arr[i] == key) { // Match found
                System.out.print(i + " "); // Print index
                found = true; // Mark found
            }
        }
        if (!found) System.out.println("Number not found"); // If not found
        sc.close();
    }
}
// Time Complexity: O(n) worst case