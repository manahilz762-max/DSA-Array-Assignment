import java.util.Scanner;
public class Task02 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();

        int max = arr[0], min = arr[0]; // Assume first is max/min
        int maxIndex = 0, minIndex = 0; // Store indices
        int secondMin = Integer.MAX_VALUE; // For second minimum

        for (int i = 1; i < arr.length; i++) { // Find max and min
            if (arr[i] > max) { // If current > max
                max = arr[i]; // Update max
                maxIndex = i; // Update max index
            }
            if (arr[i] < min) { // If current < min
                secondMin = min; // Previous min becomes second min
                min = arr[i]; // Update min
                minIndex = i; // Update min index
            } else if (arr[i] < secondMin && arr[i] != min) { // Check second min
                secondMin = arr[i]; // Update second min
            }
        }
        System.out.println("Largest: " + max + " at index " + maxIndex);
        System.out.println("Smallest: " + min + " at index " + minIndex);
        System.out.println("Second Minimum: " + secondMin);
        sc.close();
    }
}
// Time Complexity: O(n) - single pass