import java.util.Scanner;
public class Task09 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();
        boolean[] visited = new boolean[10]; // To avoid recounting
        for (int i = 0; i < arr.length; i++) { // Check each element
            if (visited[i]) continue; // Already counted
            int count = 1; // Occurrence count
            for (int j = i+1; j < arr.length; j++) { // Find duplicates
                if (arr[i] == arr[j]) {
                    count++; // Increase count
                    visited[j] = true; // Mark as visited
                }
            }
            if (count > 1) { // Is duplicate
                System.out.println(arr[i] + " occurs " + count + " times");
            }
        }
        sc.close();
    }
}
// Time Complexity: O(n^2)