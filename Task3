import java.util.Scanner;
public class Task03 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();
        int sum = 0; // Initialize sum
        for (int i = 0; i < arr.length; i++) sum += arr[i]; // Add each element
        double avg = (double) sum / arr.length; // Calculate average
        int count = 0; // Count > avg
        for (int i = 0; i < arr.length; i++) { // Check each element
            if (arr[i] > avg) count++; // Increment if greater
        }
        System.out.println("Sum: " + sum + ", Average: " + avg);
        System.out.println("Elements greater than average: " + count);
        sc.close();
    }
}
// Time Complexity: O(n)