import java.util.Scanner;
public class Task05 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[11]; // Extra space for insertion
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();
        System.out.print("Enter index to insert (0-10): ");
        int index = sc.nextInt(); // Insertion position
        System.out.print("Enter number: ");
        int num = sc.nextInt(); // Number to insert
        for (int i = 10; i > index; i--) { // Shift right
            arr[i] = arr[i-1]; // Move element to right
        }
        arr[index] = num; // Insert at position
        System.out.print("Updated array: ");
        for (int i = 0; i < 11; i++) System.out.print(arr[i] + " ");
        sc.close();
    }
}
// Time Complexity: O(n) for shifting