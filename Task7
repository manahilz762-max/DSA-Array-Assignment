import java.util.Scanner;
public class Task08 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();
        for (int i = 0; i < arr.length - 1; i++) { // Outer loop
            for (int j = 0; j < arr.length - 1 - i; j++) { // Inner loop
                if (arr[j] > arr[j+1]) { // If out of order
                    int temp = arr[j]; // Swap
                    arr[j] = arr[j+1];
                    arr[j+1] = temp;
                }
            }
        }
        System.out.print("Ascending: ");
        for (int x : arr) System.out.print(x + " ");
        System.out.print("\nDescending: ");
        for (int i = arr.length - 1; i >=0; i--) System.out.print(arr[i] + " ");
        sc.close();
    }
}
// Time Complexity: O(n^2) - Bubble Sort